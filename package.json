{
  "name": "pony-bead-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline PWA for designing and making pony bead projects",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "lucide-preact": "1.66.0",
    "preact": "10.29.8",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
